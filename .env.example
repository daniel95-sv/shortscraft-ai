# ShortsCraft AI - Plantilla de Variables de Entorno (Ejemplo Público)
# Copia este archivo a `.env.local` para configurar tus claves privadas localmente.
# NUNCA agregues tus claves reales en este archivo ni lo compartas públicamente.

# Google Gemini API Key (Recomendada / Gratis en https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# Groq Cloud API Key (Ultra Rápido Llama 3 en https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# Pexels API Key (Para videos B-roll gratis en https://www.pexels.com/api/)
VITE_PEXELS_API_KEY=

# OpenAI API Key (Opcional en https://platform.openai.com/api-keys)
VITE_OPENAI_API_KEY=

# ElevenLabs API Key (Opcional para voces hiperrealistas)
VITE_ELEVENLABS_API_KEY=
